# Copy to .env.local and fill in. Values for local Supabase come from `supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Signs the short-lived tap cookie. Generate with: openssl rand -base64 48
TAP_TOKEN_SECRET=

# Public base URL used in printed QR codes (defaults to the request origin)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: rate limiting. Without these, rate limits are disabled (fine for local dev).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Web push (streak reminders). Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Protects /api/cron/* (Vercel Cron sends it as a Bearer token). Generate with: openssl rand -hex 32
CRON_SECRET=

# Clover POS (Phase 3). From your app in the Clover developer dashboard.
CLOVER_APP_ID=
CLOVER_APP_SECRET=
# sandbox | na | eu | la
CLOVER_ENVIRONMENT=sandbox
# "Clover Auth Code" shown in the app's Webhooks settings once the webhook URL is verified.
CLOVER_WEBHOOK_AUTH_CODE=
# Encrypts POS tokens at rest. Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# AI-written offers (optional; without it offers use standard wording).
ANTHROPIC_API_KEY=
